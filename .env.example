# ======== 案件处理系统 V5 配置模板 ========
# 复制本文件为 .env 并填入真实值后使用

# ---- 火山引擎 OCR ----
VOLCENGINE_AK=your_access_key_id
VOLCENGINE_SK=your_secret_access_key
VOLCENGINE_REGION=cn-north-1

# ---- DeepSeek ----
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-pro
# API 地址（默认官方地址；如使用中转/代理请改这里）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
# 可选：失败重试次数（默认2，指数退避；业务错误不重试）
# DEEPSEEK_MAX_RETRIES=2

# ---- 火山引擎 OCR ----
# 可选：失败重试次数（默认2，指数退避；业务错误不重试）
# OCR_MAX_RETRIES=2

# ---- 登录凭据（远程模式） ----
LOGIN_USERNAME=admin
LOGIN_PASSWORD=your_password

# ---- 数据与路径 ----
# 本地 SQLite 模式已移除，统一使用远程 API（见 SERVER_URL）
SERVER_URL=http://127.0.0.1:8899
CASE_FOLDER=C:\path\to\2026年度【1721-】
CASE_FOLDER_2=C:\path\to\2025年度【1099--1720】
RESPONSE_FOLDER=C:\path\to\应诉材料
JUDGMENT_FOLDER=C:\path\to\判决书
PRESERVE_FOLDER=C:\path\to\保全裁定
